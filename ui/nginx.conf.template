server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    location /api/ {
        proxy_pass ${NORC_API_URL};
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection '';
        proxy_set_header Host $host;
        proxy_cache_bypass $http_upgrade;
        # Required for SSE
        proxy_buffering off;
        proxy_read_timeout 3600s;
    }

    # Notion webhooks land on the same public origin as everything else.
    location /webhooks/ {
        proxy_pass ${NORC_API_URL};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
    }

    # Agent avatars — public, fetched by Slack and the dashboard. Without this
    # block the SPA fallback answers with index.html and every avatar breaks.
    location /icons/ {
        proxy_pass ${NORC_API_URL};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
    }

    # Public feedback forms — humans open these from Slack/email with no
    # session. Without this block the SPA fallback answers with index.html
    # and the link lands on the dashboard instead of the form. (Generated
    # links use /api/feedback/form/… and work regardless; this covers the
    # short /feedback/… alias.)
    location /feedback/ {
        proxy_pass ${NORC_API_URL};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
