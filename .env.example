# NORC — copy this file to .env and fill in the values

# Public URL of the server — used to generate agent invite prompts
# For local dev: http://localhost:3001
# For production: your domain or tunnel (Cloudflare, ngrok, etc.)
NORC_PUBLIC_URL=http://localhost:3001

# Port the backend listens on
PORT=3001

# SQLite database path (relative to server/ directory)
DATABASE_PATH=./norc.db
