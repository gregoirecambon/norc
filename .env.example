# NORC — copy this file to .env and fill in the values.
# Only NORC_PUBLIC_URL and one OAuth provider are required to get started.

# ── Core ─────────────────────────────────────────────────────────────────────

# The single public origin of your NORC install (the nginx ui container, or
# your reverse proxy / tunnel in front of it). Drives OAuth redirect URIs,
# team invite links, agent invite prompts, and the Notion webhook URL.
#   Local dev:   http://localhost:3000
#   Production:  https://norc.yourdomain.com
NORC_PUBLIC_URL=http://localhost:3000

# Port the backend listens on (the ui container proxies to it internally).
PORT=3001

# SQLite database path. Docker sets this to /data/norc.db via docker-compose;
# for local dev it resolves relative to server/.
DATABASE_PATH=./norc.db

# ── Sign-in (OAuth) — configure at least one provider ───────────────────────

# Google: https://console.cloud.google.com/apis/credentials
#   Authorized redirect URI: ${NORC_PUBLIC_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub: https://github.com/settings/developers → New OAuth App
#   Authorization callback URL: ${NORC_PUBLIC_URL}/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ── Invite emails (optional — without SMTP you get copyable invite links) ───

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Set to true for implicit TLS (port 465); STARTTLS on 587 works without it.
SMTP_SECURE=false

# ── Slack (optional — usually configured from Settings → Slack instead) ─────

# Env fallback for the Slack connection; values saved on the dashboard win.
# Bot token (xoxb-…) + the app's signing secret from Basic Information.
# SLACK_BOT_TOKEN=
# SLACK_SIGNING_SECRET=

# ── Misc (optional) ──────────────────────────────────────────────────────────

# Raises the GitHub API rate limit for the update checker (any classic token).
GITHUB_TOKEN=

# Session cookies get the Secure flag automatically when NORC_PUBLIC_URL is
# https. Set to 0 to force it off (plain-http LAN installs) or 1 to force on.
# COOKIE_SECURE=0
