# NORC infrastructure config
# Run `norc init` after starting Docker — it handles everything else.

# Public HTTPS URL where Notion delivers webhooks
# Use Cloudflare Tunnel, ngrok, or your own domain
NORC_PUBLIC_URL=https://your-tunnel.example.com

# Server ports
PORT=3001

# Redis (matches docker-compose.yml — only change if running Redis externally)
REDIS_URL=redis://redis:6379
