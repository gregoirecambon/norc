# Notion
NOTION_API_KEY=secret_...
NOTION_WEBHOOK_SECRET=...
NOTION_ORG_DB_ID=...
NOTION_TASKS_DB_ID=...
NOTION_PROJECTS_DB_ID=...

# Optional: company context for strategic-level agents
NORC_COMPANY_PAGE_ID=...

# Agents
ANTHROPIC_API_KEY=sk-ant-...
NORC_WORK_DIR=/path/to/your/repo
NORC_AGENT_TIMEOUT_MIN=30

# Network
NORC_PUBLIC_URL=https://your-tunnel.example.com
PORT=3001

# Redis
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
