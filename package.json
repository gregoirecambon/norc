{
  "name": "norc",
  "version": "0.11.9",
  "description": "Notion Orchestration for AI Agents",
  "private": true,
  "scripts": {
    "dev": "pnpm --parallel --filter \"@norc/server\" --filter \"@norc/ui\" run dev",
    "build": "pnpm --filter \"@norc/server\" --filter \"@norc/ui\" run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm -r run typecheck"
  },
  "keywords": [
    "notion",
    "ai-agents",
    "orchestration"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "typescript": "^5.7.3",
    "vitest": "^4.1.8"
  }
}
